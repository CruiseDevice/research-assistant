# --- LLM configuration ---
# Provider to use: "anthropic" or "openai"
LLM_PROVIDER=openai
# Model name for the selected provider
LLM_MODEL=gpt-4o

# --- LLM provider API keys ---
# Used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Used when LLM_PROVIDER=openai
OPENAI_API_KEY=

# --- Search configuration ---
# Search backend: "tavily" (default)
SEARCH_PROVIDER=tavily
# Search mode: "parallel" (default, planner + fan-out) or "react" (legacy ReAct summarizer)
SEARCH_MODE=parallel
# Used when SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# --- Session memory ---
# Path to the SQLite session log. Empty (default) uses
# ~/.langgraph-research-assistant/sessions.db
SESSION_DB_PATH=
